generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role is a string: ADMIN, AUDIT, or CASHIER
model User {
  id               String   @id @default(uuid())
  username         String   @unique
  password         String
  email            String?  @unique
  name             String?
  alternativeNames String?
  role             String   @default("CASHIER")
  branch           Branch?  @relation(fields: [branchId], references: [id])
  branchId         String?
  status           String?
  bonusBalance     Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sales                    Sale[]
  commissions              Commission[]
  shifts                   Shift[]
  stockTransfersRequested  StockTransfer[]              @relation("StockTransferRequestedBy")
  stockTransfersAccepted   StockTransfer[]              @relation("StockTransferAcceptedBy")
  stockTransfersDispatched StockTransfer[]              @relation("StockTransferDispatchedBy")
  stockTransfersReceived   StockTransfer[]              @relation("StockTransferReceivedBy")
  stockTransfersClosed     StockTransfer[]              @relation("StockTransferClosedBy")
  skuCorrectionsReported   StockTransferSkuCorrection[] @relation("StockTransferSkuCorrectionReportedBy")
  skuCorrectionsReviewed   StockTransferSkuCorrection[] @relation("StockTransferSkuCorrectionReviewedBy")
  skuCorrectionsReceived   StockTransferSkuCorrection[] @relation("StockTransferSkuCorrectionReceivedBy")
}

model Branch {
  id                 String   @id @default(uuid())
  name               String
  address            String?
  phone              String?
  allowEmployeeInput Boolean  @default(true)
  createdAt          DateTime @default(now())

  users                User[]
  sales                Sale[]
  adjustments          Adjustment[]
  shifts               Shift[]
  stockSnapshots       StockSnapshot[]
  productStocks        ProductStock[]
  commissions          Commission[]
  voucherSNs           VoucherSN[]
  dailyIncomeSummaries DailyIncomeSummary[]
  stockAudits          BranchStockAudit[]
  stockTransfersFrom   StockTransfer[]      @relation("StockTransferSource")
  stockTransfersTo     StockTransfer[]      @relation("StockTransferTarget")
}

model Product {
  id               String    @id @default(uuid())
  barcode          String?   @unique
  name             String
  category         String?
  subCategory      String?
  brand            String?
  provider         String?
  description      String?
  sn               String?
  masterSN         String?
  buyingPrice      Float
  sellingPrice     Float
  discountPrice    Float?
  commissionAmount Float     @default(0)
  minStock         Int       @default(0)
  expiredAt        DateTime?
  unit             String?
  status           String    @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  visibleBranchIds String    @default("*") // "*" for all; "!id,id" for all except; comma-separated IDs for selected; "__NONE__" for none
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  saleItems            SaleItem[]
  commissions          Commission[]
  adjustments          Adjustment[]
  stockSnapshots       StockSnapshot[]
  stocks               ProductStock[]
  voucherSNs           VoucherSN[]
  stockTransfers       StockTransfer[]
  skuCorrectionsActual StockTransferSkuCorrection[] @relation("StockTransferSkuCorrectionActualProduct")
}

model ProductStock {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  branch    Branch  @relation(fields: [branchId], references: [id])
  branchId  String
  qty       Int     @default(0)

  @@unique([productId, branchId])
}

model VoucherSN {
  id          String   @id @default(uuid())
  sn          String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  branch      Branch   @relation(fields: [branchId], references: [id])
  branchId    String
  status      String // available, sold, refunded
  productName String?
  saleId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sale {
  id                     String   @id @default(uuid())
  branch                 Branch   @relation(fields: [branchId], references: [id])
  branchId               String
  cashier                User     @relation(fields: [cashierId], references: [id])
  cashierId              String
  customerName           String?
  total                  Float
  totalCommission        Float
  totalProfit            Float    @default(0)
  status                 String // success, refunded, cancelled
  idempotencyKeyHash     String?  @unique
  idempotencyPayloadHash String?
  createdAt              DateTime @default(now())

  items             SaleItem[]
  commissions       Commission[]
  idempotencyRecord SaleIdempotency?

  @@index([branchId, status, createdAt])
  @@index([status, createdAt])
  @@index([createdAt, id])
}

model SaleIdempotency {
  id             String    @id @default(uuid())
  scopeKeyHash   String    @unique
  payloadHash    String
  state          String
  saleId         String?   @unique
  sale           Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  originalSaleId String?
  resultSnapshot Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  archivedAt     DateTime?

  @@index([state, createdAt])
}

model SaleItem {
  id        String  @id @default(uuid())
  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  qty       Int
  price     Float // Selling price at time of sale
  costPrice Float // Buying price at time of sale
  subtotal  Float
  sn        String?
}

model Commission {
  id          String    @id @default(uuid())
  sale        Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleId      String?
  product     Product   @relation(fields: [productId], references: [id])
  productId   String
  qty         Int
  sn          String?
  amount      Float
  cashier     User      @relation(fields: [cashierId], references: [id])
  cashierId   String
  branch      Branch    @relation(fields: [branchId], references: [id])
  branchId    String
  status      String // earned, refunded, withdrawn
  createdAt   DateTime  @default(now())
  refundedAt  DateTime?
  withdrawnAt DateTime?
}

model Adjustment {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  branch    Branch   @relation(fields: [branchId], references: [id])
  branchId  String
  qty       Int
  type      String // STOCK_IN, STOCK_OUT, TRANSFER_IN, TRANSFER_OUT
  reason    String?
  createdAt DateTime @default(now())
}

model StockTransfer {
  id              String                       @id @default(uuid())
  batchId         String?
  productId       String
  product         Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceBranchId  String
  sourceBranch    Branch                       @relation("StockTransferSource", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  targetBranchId  String
  targetBranch    Branch                       @relation("StockTransferTarget", fields: [targetBranchId], references: [id], onDelete: Restrict)
  kind            String // REQUEST, DIRECT
  status          String // REQUESTED, ACCEPTED, IN_TRANSIT, RECEIVED, REJECTED, CANCELLED
  requestedQty    Int?
  approvedQty     Int?
  dispatchedQty   Int?
  receivedQty     Int?
  requestNote     String?
  responseNote    String?
  discrepancyNote String?
  requestedById   String?
  requestedBy     User?                        @relation("StockTransferRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  acceptedById    String?
  acceptedBy      User?                        @relation("StockTransferAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  dispatchedById  String?
  dispatchedBy    User?                        @relation("StockTransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedById    String?
  receivedBy      User?                        @relation("StockTransferReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  closedById      String?
  closedBy        User?                        @relation("StockTransferClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                     @default(now())
  acceptedAt      DateTime?
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  closedAt        DateTime?
  skuCorrections  StockTransferSkuCorrection[]
  returnOfId      String?
  returnOf        StockTransfer?               @relation("StockTransferReturnOf", fields: [returnOfId], references: [id], onDelete: Restrict)
  returns         StockTransfer[]              @relation("StockTransferReturnOf")

  @@index([sourceBranchId, status, createdAt])
  @@index([targetBranchId, status, createdAt])
  @@index([productId, createdAt])
  @@index([batchId, createdAt])
  @@index([returnOfId, createdAt])
}

model StockTransferSkuCorrection {
  id              String        @id @default(uuid())
  transferId      String
  transfer        StockTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  actualProductId String
  actualProduct   Product       @relation("StockTransferSkuCorrectionActualProduct", fields: [actualProductId], references: [id], onDelete: Restrict)
  actualQty       Int
  note            String
  status          String // PENDING_SOURCE, APPROVED_PENDING_RECEIPT, REJECTED, RECEIVED
  responseNote    String?
  reportedById    String?
  reportedBy      User?         @relation("StockTransferSkuCorrectionReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  reviewedById    String?
  reviewedBy      User?         @relation("StockTransferSkuCorrectionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  receivedById    String?
  receivedBy      User?         @relation("StockTransferSkuCorrectionReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  reviewedAt      DateTime?
  receivedAt      DateTime?

  @@index([transferId, createdAt])
  @@index([status, createdAt])
  @@index([actualProductId, createdAt])
}

model GlobalConfig {
  id                     String   @id @default("default")
  allowCashierStockInput Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

model Shift {
  id             String    @id @default(uuid())
  branch         Branch    @relation(fields: [branchId], references: [id])
  branchId       String
  cashier        User      @relation(fields: [cashierId], references: [id])
  cashierId      String
  openTime       DateTime  @default(now())
  closeTime      DateTime?
  initialCash    Float
  totalSales     Float     @default(0)
  // Legacy database column stores the cashier-reported total income.
  reportedIncome Float?    @map("actualCash")
  difference     Float?
  shiftDate      String
  shiftType      String?
  status         String // open, closed

  stockSnapshots StockSnapshot[]
}

model StockSnapshot {
  id         String   @id @default(uuid())
  branch     Branch   @relation(fields: [branchId], references: [id])
  branchId   String
  shift      Shift?   @relation(fields: [shiftId], references: [id])
  shiftId    String?
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  initialQty Int
  soldQty    Int
  finalQty   Int
  timestamp  DateTime @default(now())
  type       String // SHIFT_CLOSE, AUDIT_CHECK
}

model BranchStockAudit {
  id                 String                 @id @default(uuid())
  branchId           String
  branch             Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchNameSnapshot String
  activeBranchId     String?                @unique
  status             String                 @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  startedById        String
  startedByName      String
  startedAt          DateTime               @default(now())
  completedById      String?
  completedByName    String?
  completedAt        DateTime?
  cancelledById      String?
  cancelledByName    String?
  cancelledAt        DateTime?
  items              BranchStockAuditItem[]

  @@index([branchId, startedAt])
  @@index([status, startedAt])
}

model BranchStockAuditItem {
  id                  String           @id @default(uuid())
  auditId             String
  audit               BranchStockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  productId           String
  productNameSnapshot String
  barcodeSnapshot     String?
  masterSNSnapshot    String?
  inScope             Boolean          @default(true)
  expectedQty         Int              @default(0)
  baselineQty         Int?
  countedQty          Int?
  variance            Int?
  status              String           @default("PENDING") // PENDING, COUNTING, COUNTED, RECOUNT_REQUIRED, EXCLUDED
  finding             String?
  notes               String?
  countStartedById    String?
  countStartedByName  String?
  countStartedAt      DateTime?
  countedById         String?
  countedByName       String?
  countedAt           DateTime?
  appliedAt           DateTime?
  createdAt           DateTime         @default(now())

  @@unique([auditId, productId])
  @@index([auditId, inScope, status])
  @@index([auditId, productNameSnapshot])
}

model DailyIncomeSummary {
  id              String   @id @default(uuid())
  date            String // format: "YYYY-MM-DD"
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id])
  revenue         Float    @default(0)
  totalProfit     Float    @default(0)
  totalCommission Float    @default(0)
  salesCount      Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([branchId, date])
}

// Shopping plans were previously stored in Firestore ("shoppingPlans"); now stored locally.
model ShoppingPlan {
  id        String   @id @default(uuid())
  title     String?
  items     Json     @default("[]")
  status    String   @default("DRAFT")
  creatorId String?
  createdAt DateTime @default(now())
}
