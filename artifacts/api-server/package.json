{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "export NODE_ENV=development DB_RUNTIME_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:authz": "tsx --test src/read-routes.test.ts",
    "test:memory-diagnostics": "tsx --test src/memory-diagnostics.test.ts",
    "test:shift-read-range": "tsx --test src/shift-read-range.test.ts",
    "test:sale-pagination": "tsx --test src/sale-pagination.test.ts",
    "test:sales-read-scope": "TZ=Asia/Jakarta tsx --test ../../artifacts/alfath-pos/src/services/sales-read-scope.test.ts",
    "test:startup": "tsx --test src/database-startup.test.ts",
    "test:startup:integration": "tsx --test src/database-startup.integration.test.ts",
    "test:owner-bootstrap:integration": "tsx --test src/owner-bootstrap.integration.test.ts",
    "test:schema-init": "tsx --test src/database-schema-init.test.ts",
    "test:schema-init:integration": "tsx --test src/database-schema-init.integration.test.ts",
    "db:check": "tsx src/database-check-cli.ts",
    "db:admin": "tsx src/maintenance-main.ts",
    "db:init-schema": "tsx src/schema-init-main.ts",
    "db:push": "tsx src/schema-init-main.ts",
    "db:studio": "prisma studio",
    "test:auth": "pnpm run build && node --import tsx --test src/auth.integration.test.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@workspace/api-zod": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0"
  }
}
