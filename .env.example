# Template only. Copy to .env and fill every required value before using Compose.
# Never commit the filled .env file.

# PostgreSQL service
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# API database target. DB_EXPECTED_NAME must match POSTGRES_DB.
DATABASE_URL=
DB_RUNTIME_ENV=production
DB_EXPECTED_HOST=db
DB_EXPECTED_NAME=
DB_EXPECTED_PORT=5432
DB_EXPECTED_SCHEMA=public
JWT_SECRET=

# Used only by the separately approved first-install seed.
# Remove these values from .env after the seed completes.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_CASHIER_USERNAME=
INITIAL_CASHIER_PASSWORD=

# Web access and local backups
WEB_PORT=8080
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP_DAYS=14
